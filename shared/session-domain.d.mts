export const SCHEMA_VERSION: 1;
export const MODES: readonly ['discussion', 'rehearsal'];
export const RECORD_KINDS: readonly string[];
export const SESSION_STATES: readonly string[];
export type SessionMode = 'discussion' | 'rehearsal';
export type SessionStatus = 'draft' | 'ready' | 'running' | 'paused' | 'completed' | 'stopped' | 'failed';
export type Draft = { title: string; mode: SessionMode; situation: string };
export type Brain = { provider: string; model: string | null };
export type RecordBase = { schemaVersion: 1; kind: string; id: string; profileId: string; createdAt: string; updatedAt: string };
export type Character = RecordBase & { kind: 'character'; name: string; personality: string; code: string; avatar: { seed: number; attributes: Record<string, string>;realistic?:{modelId:string} }; voice: { provider: string; id: string } | null; brain: Brain | null; voicePreference?: { style: string; pace: string } };
export type Scenario = RecordBase & { kind: 'scenario'; mode: SessionMode; format: 'roundtable' | 'hearing' | 'adversarial' | 'panel'; intensity: 'calm' | 'formal' | 'probing' | 'heated'; situation: string; goal: string; durationMinutes: number; context: { id: string; name: string; status: 'pending' | 'reviewed' | 'unreadable' }[]; rubric: { id: string; name: string; description: string }[] };
export type Participant = RecordBase & { kind: 'participant'; characterId: string; role: string; code: string; position: string; brain: Brain | null; active: boolean };
export type Contribution = RecordBase & { kind: 'contribution'; participantId: string; requestId: string; epoch: number; text: string; brain: Brain; relatedIds: string[]; discussion?:true;position?:string;questionForParticipantId?:string|null;turnKind?:string;scopeVersion?:number;needsUserInput?:boolean };
export type Rating = RecordBase & { kind: 'rating'; contributionId: string; criterion: string; value: number; source: 'user' | 'system'; reason: string; revision: number };
export type DecisionPoint = RecordBase & { kind: 'decision-point'; topic: string; presenterId: string | null; dependencies: string[]; options: { id: string; label: string }[]; choiceId: string | null; rationale: string; status: 'pending' | 'deferred' | 'decided' | 'needs-review'; depth: 'simple' | 'full' };
export type Outcome = RecordBase & { kind: 'outcome'; reportType: 'decision-brief' | 'practice-report' | 'partial'; summary: string; references: string[] };
export type SessionEvent = { schemaVersion: 1; id: string; requestId: string; sequence: number; type: 'session.created' | 'session.updated' | 'session.cancelled' | 'session.transitioned' | 'session.roster-updated' | 'session.assigned' | 'session.exchange' | 'session.character-updated' | 'session.guidance' | 'session.discussion-control' | 'session.discussion-turn' | 'session.discussion-brief' | 'session.discussion-cast'; at: string; epoch: number; command: string };
export type Exchange = { id: string; requestId: string; characterId: string; userText: string; text: string; brain: Brain; epoch: number; at: string };
export type SetupProposal = { title:string; mode:SessionMode; format:Scenario['format']; intensity:Scenario['intensity']; situation:string; goal:string; constraints:string[]; durationMinutes:number; rubric:{name:string;description:string}[]; cast:{name:string;role:string;reason:string;code:string;personality:string}[] };
export type SetupContext = {id:string;name:string;status:'pending'|'reviewed'|'unreadable';text:string;error:string};
export type GuidedSetup = {stage:'capture'|'review'|'cast'|'ready';proposal:SetupProposal|null;brain:Brain|null;context:SetupContext[];confirmedAt:string|null};
export type SessionGuidance = { schemaVersion: 1; tutorialVersion: 1; guide: Character | null; activeLesson: string | null; notes: { id: string; text: string; source: 'user' | 'interpretation'; status: 'unconfirmed' | 'confirmed' }[]; setup?:GuidedSetup };
export type Discussion = {schemaVersion:1;style?:'group'|'coaching';briefs?:import('./discussion-memory.mjs').WorkingBrief[];castJobs?:import('./discussion-memory.mjs').CastJob[];awaitingUser?:string|null;proceedWithAssumptions?:boolean;turnLimit:number;turnsUsed:number;elapsedMs:number;runningSince:string|null;nextIndex:number;reason:string;interventions:{id:string;action:string;text:string;targetId:string|null;afterId:string|null;consumedBy:string|null;at:string}[]};
export type Session = RecordBase & { kind: 'session'; title: string; status: SessionStatus; revision: number; epoch: number; scenario: Scenario; guidance?: SessionGuidance; exchanges?: Exchange[];discussion?:Discussion; characters: Character[]; participants: Participant[]; contributions: Contribution[]; ratings: Rating[]; decisions: DecisionPoint[]; outcomes: Outcome[]; events: SessionEvent[] };
export type Mutation = { requestId: string; expectedRevision: number; now?: string };
export class SessionError extends Error { status: number; code: string; constructor(message: string, status?: number, code?: string); }
export function isId(value: unknown): value is string;
export function validateRecord<T extends RecordBase>(value: T, expectedKind?: string): T;
export function createRecord<T extends RecordBase>(kind: T['kind'], profileId: string, fields: Omit<T, keyof RecordBase>, options?: { id?: string; now?: string }): T;
export function validateSession(value: unknown): Session;
export function normaliseDraft(value: unknown): Draft;
export function createSession(input: { id?: string; profileId: string; requestId: string; draft: Draft; guide?: Character | null; now?: string }): Session;
export function updateDraft(session: Session, mutation: Mutation & { draft: Draft }): Session;
export function cancelPending(session: Session, mutation: Mutation): Session;
export function updateRoster(session: Session, mutation: Mutation & { entries: { characterId: string; role: string; code?: string }[]; guide?: Character }, libraryCharacters: Character[]): Session;
export function assignCharacter(session: Session, mutation: Mutation & { characterId: string; brain: Brain; voice: Character['voice'] }): Session;
export function applyCharacter(session: Session, mutation: Mutation, savedCharacter: Character): Session;
export function recordExchange(session: Session, mutation: Mutation & { characterId: string; userText: string; text: string; brain: Brain; epoch: number }): Session;
export function transitionSession(session: Session, mutation: Mutation & { status: SessionStatus }): Session;
export function isCurrentEpoch(session: Session, epoch: number): boolean;
