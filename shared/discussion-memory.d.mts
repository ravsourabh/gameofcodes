import type {Session,Mutation,Brain,Character} from './session-domain.mjs';
export type VoiceSuggestion={name:string;role:string;reason:string;code:string;personality:string};
export type BriefProposal={title:string;topic:string;goal:string;excludedTopics:string[];assumptions:string[];voices:VoiceSuggestion[]};
export type WorkingBrief=BriefProposal&{id:string;scopeVersion:number;sourceIds:string[];brain:Brain;at:string};
export type CastJob={requestId:string;status:'pending'|'completed'|'cancelled';scopeVersion:number;items:{id:string;createRequestId:string;role:string;fields:any;brain:Brain;voice:Character['voice']}[]};
export function normaliseTopic(text:string):string;
export function currentBrief(s:Session):WorkingBrief|null;
export function userDirections(s:Session):NonNullable<Session['discussion']>['interventions'];
export function scopeVersion(s:Session):number;
export function currentScopeTurns(s:Session):Session['contributions'];
export function needsBrief(s:Session):boolean;
export function explicitScope(s:Session):Pick<BriefProposal,'title'|'topic'|'goal'|'excludedTopics'>|null;
export function isScopeCorrection(text:unknown):boolean;
export function groundBriefProposal(proposal:BriefProposal,s:Session):BriefProposal;
export function validateBriefProposal(proposal:unknown,s:Session):BriefProposal;
export function validateDiscussionMemory(s:Session):void;
export function saveDiscussionBrief(s:Session,m:Mutation&{brief:BriefProposal;brain:Brain}):Session;
export function saveCastPlan(s:Session,m:Mutation&{items:CastJob['items']}):Session;
export function completeCastPlan(s:Session,m:Mutation&{jobId:string}):Session;
