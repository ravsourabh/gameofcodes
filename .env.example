# Copy to .env.local. Keep real keys on the server; never use VITE_ names.
# Local env files are excluded from Git and Docker build context.
SOVEREIGN_MODE=cloud

# Configure at least one model provider. Add others to compare model assignments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional. The key needs voice-catalogue read (voices_read) and speech access.
# OpenAI/device voices are separate explicit choices in the avatar workshop.
ELEVENLABS_API_KEY=

# Hindi mode uses Sarvam Bulbul v3 speech. Keep the key server-side.
SARVAM_API_KEY=

# Optional P02 publishing connections. Disabled until origin, owner and protected
# gateway are configured. Never use VITE_ names or paste credentials into chat.
# Generate a private gateway token with scripts/configure-publishing.mjs.
GOC_PUBLISHING_ORIGIN=https://app.gameofcodes.si
GOC_PUBLISHING_OWNER_PROFILE=
GOC_PUBLISHING_GATEWAY_TOKEN=
GOC_GOOGLE_CLIENT_ID=
GOC_GOOGLE_CLIENT_SECRET=
# testing or production: record the actual Google consent app mode.
GOC_GOOGLE_APP_MODE=testing
# This uses Instagram Login, not the Facebook Login permission family.
GOC_INSTAGRAM_APP_ID=
GOC_INSTAGRAM_APP_SECRET=
GOC_INSTAGRAM_API_VERSION=v22.0
GOC_INSTAGRAM_APP_MODE=development
# Private temporary storage is selected in P03; no resource is auto-provisioned.
GOC_PUBLISHING_STORAGE_PROVIDER=
GOC_PUBLISHING_S3_BUCKET=
GOC_PUBLISHING_S3_REGION=
GOC_PUBLISHING_S3_ACCESS_KEY_ID=
GOC_PUBLISHING_S3_SECRET_ACCESS_KEY=

# Optional. Model, speech and transcription requests allowed per server per day
# (default 1500). Profiles are not accounts, so this caps public spend.
SOVEREIGN_DAILY_AI_REQUESTS=

# META_LLAMA_API_KEY is retained in existing deployments but is not used by
# the new session runtime until its model-routing capability is verified.
