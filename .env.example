# Copy to .env.local. Keep real keys on the server; never use VITE_ names.
# Local env files are excluded from Git and Docker build context.
SOVEREIGN_MODE=cloud

# Configure at least one model provider. Add others to compare model assignments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional. The key needs voice-catalogue read (voices_read) and speech access.
# OpenAI/device voices are separate explicit choices in the avatar workshop.
ELEVENLABS_API_KEY=

# Hindi mode uses Sarvam Bulbul v3 speech. Keep the key server-side.
SARVAM_API_KEY=

# Optional. Model, speech and transcription requests allowed per server per day
# (default 1500). Profiles are not accounts, so this caps public spend.
SOVEREIGN_DAILY_AI_REQUESTS=

# META_LLAMA_API_KEY is retained in existing deployments but is not used by
# the new session runtime until its model-routing capability is verified.
