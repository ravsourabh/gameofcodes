{
  "name": "game-of-codes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/dev.mjs --production",
    "test": "node node_modules/@playwright/test/cli.js test",
    "setup:browser": "node node_modules/@playwright/test/cli.js install chromium",
    "test:unit": "node --test tests/protocol.test.mjs tests/court.test.mjs tests/providers.test.mjs tests/speech.test.mjs tests/cloud-providers.test.mjs tests/workspace-setup.test.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "iwer": "^2.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
